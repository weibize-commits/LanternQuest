# The checked-in default is the reproducible offline mock.
VITE_DECISION_MODE=mock

# For a real study, use the local research server backed by frozen Qwen3-8B.
# E20 material must not be sent to an external model provider.
VITE_DECISION_API_URL=http://127.0.0.1:8765/api/decision
VITE_DECISION_TIMEOUT_MS=420000
