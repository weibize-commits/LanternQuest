    "automatic_obligation_policy": "unsupported_or_stalled",
    "max_automatic_obligations_per_episode": 3,
    "failure_policy": "超时、环境异常、无法解析输出和非法动作均保留并分类，不从分母删除。"
  },
  "mechanism": {
    "unsupported_action": "若 IPER 候选动作在已检索的同任务训练程序中没有同操作符证据，则生成一次动作证据义务、做任务图加权检索并重新规划。",
    "execution_stall": "若动作后 observation 哈希不变、reward=0 且未终止，则生成一次停滞恢复义务并重新检索。",
    "loop_control": "同一 observation 哈希与动作组合的同类自动义务最多触发一次。",
    "controller_budget": "每个 episode 最多触发3次自动义务；自动模式关闭模型自由 request_evidence，以隔离控制器机制。",
    "information_boundary": "训练技能检索不能揭示当前 variation 的隐藏对象位置；look/open/close/go/inventory 等观察导航操作不触发程序缺失义务。",
    "control": "B4 继续使用固定初始检索，自动义务只对 IPER 生效。"
  },
  "development_amendment": {
    "basis": "开发集 task 1-1 variation 17 seed 11 的首次配对 pilot；测试集未运行。",
    "observed_failure": "模型把训练技能检索当作当前状态查询，重复提出位置问题并耗尽8次检索预算。",
    "changes_before_formal_freeze": [
