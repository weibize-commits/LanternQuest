{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/lanternquest/schemas/neural-alignment.schema.json",
  "title": "LanternQuest neural alignment candidate",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "source_observation_id",
    "target_entity_id",
    "model",
    "scores",
    "rule_checks",
    "source_policy"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "source_observation_id": {"type": "string", "minLength": 1},
    "target_entity_id": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "required": ["model_id", "revision", "weights_sha256", "modalities"],
      "additionalProperties": false,
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "weights_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["image", "video", "audio", "text", "document"]}
        }
      }
    },
    "scores": {
      "type": "object",
      "required": ["cross_modal_similarity", "extractor_confidence"],
      "additionalProperties": false,
      "properties": {
        "cross_modal_similarity": {"type": "number", "minimum": 0, "maximum": 1},
        "extractor_confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "rule_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule_id", "result", "hard"],
        "additionalProperties": false,
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "unknown"]},
          "hard": {"type": "boolean"},
          "evidence_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "source_policy": {
      "type": "object",
      "required": ["review_status", "rights_status", "processing_scope"],
      "additionalProperties": false,
      "properties": {
        "review_status": {
          "enum": ["unreviewed", "candidate", "source_checked", "domain_pending", "expert_confirmed", "rejected"]
        },
        "rights_status": {"type": "string", "minLength": 1},
        "processing_scope": {"enum": ["local_internal", "external_api", "public_release"]}
      }
    }
  }
}
