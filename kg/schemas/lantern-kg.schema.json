{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/lanternquest/schemas/lantern-kg.schema.json",
  "title": "LanternQuest knowledge graph exchange format",
  "type": "object",
  "required": ["schema_version", "graph_id", "status", "source_task_id", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1"},
    "graph_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["candidate", "source_checked", "domain_pending", "expert_confirmed", "rejected"]
    },
    "source_task_id": {"type": "string", "minLength": 1},
    "generated_from": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "statistics": {"type": "object"},
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type", "label", "status", "attributes"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "status": {
          "enum": ["candidate", "source_checked", "domain_pending", "expert_confirmed", "rejected", "unreviewed"]
        },
        "attributes": {"type": "object"}
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "type", "from", "to", "status", "attributes"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "status": {
          "enum": ["candidate", "source_checked", "domain_pending", "expert_confirmed", "rejected", "unreviewed"]
        },
        "attributes": {"type": "object"}
      }
    }
  }
}
