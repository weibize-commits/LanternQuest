{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/lanternquest/schemas/lanternquest-benchmark-case.schema.json",
  "title": "LanternQuest frozen benchmark case",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "scenario_family",
    "split",
    "task_id",
    "title",
    "goal",
    "user_question",
    "state_version",
    "intent_version",
    "initial_state",
    "locked_intents",
    "completed_work_ids",
    "decision_nodes",
    "action_space",
    "evidence_obligations",
    "evidence_catalog",
    "expected_decision_type",
    "expected_unresolved_conditions",
    "gold_plan",
    "terminal_conditions",
    "source_ids",
    "canonical_content_sha256",
    "rights",
    "review"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "pattern": "^lq_[a-z0-9_]+$"},
    "scenario_family": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "development", "test"]},
    "task_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "user_question": {"type": "string", "minLength": 1},
    "state_version": {"type": "string", "minLength": 1},
    "intent_version": {"type": "string", "minLength": 1},
    "initial_state": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fact"}
    },
    "locked_intents": {
      "type": "array",
      "items": {"$ref": "#/$defs/lockedIntent"}
    },
    "completed_work_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "decision_nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/decisionNode"}
    },
    "action_space": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/action"}
    },
    "evidence_obligations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/obligation"}
    },
    "evidence_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceDocument"}
    },
    "expected_decision_type": {
      "enum": ["propose", "clarify", "conflict", "evidence_insufficient"]
    },
    "expected_unresolved_conditions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "gold_plan": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "terminal_conditions": {
      "type": "object",
      "required": ["success", "failure"],
      "additionalProperties": false,
      "properties": {
        "success": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/condition"}
        },
        "failure": {
          "type": "array",
          "items": {"$ref": "#/$defs/condition"}
        }
      }
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^src_[0-9a-f]{16}$"}
    },
    "canonical_content_sha256": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "rights": {
      "type": "object",
      "required": ["research_use_allowed", "external_processing_allowed", "review_status"],
      "additionalProperties": false,
      "properties": {
        "research_use_allowed": {"const": true},
        "external_processing_allowed": {"type": "boolean"},
        "public_release_allowed": {"type": ["boolean", "null"]},
        "model_training_allowed": {"type": ["boolean", "null"]},
        "review_status": {"enum": ["approved", "frozen"]}
      }
    },
    "review": {
      "type": "object",
      "required": ["domain_status", "annotation_status", "reviewed_at"],
      "additionalProperties": false,
      "properties": {
        "domain_status": {"enum": ["domain_approved", "frozen"]},
        "annotation_status": {"enum": ["adjudicated", "frozen"]},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "reviewer_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "required": ["predicate", "value"],
      "additionalProperties": false,
      "properties": {
        "predicate": {"type": "string", "minLength": 1},
        "value": {"enum": ["true", "false"]}
      }
    },
    "fact": {
      "type": "object",
      "required": ["fact_id", "predicate", "value", "origin", "source_ids"],
      "additionalProperties": false,
      "properties": {
        "fact_id": {"type": "string", "minLength": 1},
        "predicate": {"type": "string", "minLength": 1},
        "value": {"enum": ["true", "false", "unknown"]},
        "origin": {"type": "string", "minLength": 1},
        "subject": {"type": "string"},
        "object": {"type": "string"},
        "source_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "lockedIntent": {
      "type": "object",
      "required": ["intent_id", "description", "priority", "locked"],
      "additionalProperties": false,
      "properties": {
        "intent_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "priority": {"type": "integer", "minimum": 1, "maximum": 3},
        "locked": {"type": "boolean"}
      }
    },
    "decisionNode": {
      "type": "object",
      "required": ["decision_id", "prompt", "options", "evidence_ids"],
      "additionalProperties": false,
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "prompt": {"type": "string", "minLength": 1},
        "options": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "action": {
      "type": "object",
      "required": [
        "action_id",
        "label",
        "preconditions",
        "effects",
        "evidence_obligation_ids",
        "changes_intent_ids",
        "invalidates_work_ids",
        "action_cost"
      ],
      "additionalProperties": false,
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "preconditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
        "effects": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
        "evidence_obligation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "changes_intent_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "invalidates_work_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "action_cost": {"type": "number", "minimum": 0},
        "risk_level": {"enum": ["low", "medium", "high"]}
      }
    },
    "obligation": {
      "type": "object",
      "required": ["obligation_id", "query", "satisfied_by_evidence_ids"],
      "additionalProperties": false,
      "properties": {
        "obligation_id": {"type": "string", "minLength": 1},
        "query": {"type": "string", "minLength": 1},
        "satisfied_by_evidence_ids": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "evidenceDocument": {
      "type": "object",
      "required": ["evidence_id", "source_id", "text", "supported_claim_ids", "review_status"],
      "additionalProperties": false,
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "pattern": "^src_[0-9a-f]{16}$"},
        "text": {"type": "string", "minLength": 1},
        "supported_claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "review_status": {"enum": ["source_checked", "domain_approved"]}
      }
    }
  }
}
